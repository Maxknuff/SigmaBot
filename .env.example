# === REQUIRED ===
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# === DATABASE ===
# Path where SQLite database is stored
DATABASE_PATH=data.db

# === OPTIONAL: SECURITY APIs ===
# Get from: https://www.ipqualityscore.com/api/
# For VPN/Proxy/IP reputation checks (auto-warn suspicious users)
VPN_API_KEY=

# For malware/phishing URL scanning
URL_SCAN_API_KEY=

# Leave blank to use heuristic checking (keyword + hostname analysis)
